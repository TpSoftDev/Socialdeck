# IA: Copy to functions/.env.socialdeck-dev; these are server settings, not API keys.
PROMPT_PROVIDER=openai
OPENAI_MODEL=gpt-6.1-sol
PROMPTD_API_KEY_SECRET=PROMPTD_OPENAI_API_KEY
# Replace with comma-separated Firebase Authentication UIDs for approved team testers.
PROMPTD_TESTER_UIDS=REPLACE_WITH_TEAM_FIREBASE_UIDS
# The current REST app does not send App Check tokens; keep off until that is wired.
PROMPTD_ENFORCE_APP_CHECK=false
