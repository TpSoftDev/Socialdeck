# IA: Match the mobile prototype provider; keep real API keys in ignored .secret.local.
# Select the server AI provider. Switching requires an emulator restart or cloud redeploy.
PROMPT_PROVIDER=openai
OPENAI_MODEL=gpt-6.1-sol
# Copy to functions/.env.local for the emulator. Set the exact model from AI Studio.
GEMINI_MODEL=
# Cloud team testing denies all users unless their Firebase UIDs are listed here.
PROMPTD_TESTER_UIDS=
# Optional after monitoring/configuring a compatible client App Check provider.
PROMPTD_ENFORCE_APP_CHECK=false
